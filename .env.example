# SANDU Hub Environment Configuration

# Optional: LLM API key for SANDU's pluggable generative brain (e.g. Google Gemini API Key)
# If left blank, SANDU runs 100% offline using her built-in multi-lingual intent classifier & rule-based engine.
VITE_LLM_API_KEY=

# Optional: Enable Firebase Cloud Sync ("true" or "false")
VITE_FIREBASE_ENABLED=false
